---
// "Copy for LLM" controls: copy the paper body, or the body + appendices, as
// Markdown. Both targets are constant static files generated by the .md/.txt
// endpoints (see src/lib/markdown.ts), so this component is identical on every
// page and needs no props.
---
<div class="copy-md">
  <button type="button" class="copy-btn" data-href="/index.md" aria-label="Copy the paper body as Markdown">
    <svg class="copy-ic" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="9" y="9" width="11" height="11" rx="2" />
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
    </svg>
    <span class="copy-label">Copy body</span>
  </button>
  <button type="button" class="copy-btn" data-href="/llms-full.txt" aria-label="Copy the paper and appendices as Markdown">
    <svg class="copy-ic" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="9" y="9" width="11" height="11" rx="2" />
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
    </svg>
    <span class="copy-label">Copy body + appendix</span>
  </button>
</div>

<script>
  async function copyText(text: string) {
    if (navigator.clipboard && window.isSecureContext) {
      await navigator.clipboard.writeText(text);
      return;
    }
    // Fallback for non-secure contexts (e.g. plain-http preview).
    const ta = document.createElement("textarea");
    ta.value = text;
    ta.style.position = "fixed";
    ta.style.opacity = "0";
    document.body.appendChild(ta);
    ta.focus();
    ta.select();
    try {
      document.execCommand("copy");
    } finally {
      document.body.removeChild(ta);
    }
  }

  function flash(btn: HTMLElement, label: HTMLElement, msg: string, original: string) {
    btn.classList.add("copied");
    label.textContent = msg;
    window.setTimeout(() => {
      label.textContent = original;
      btn.classList.remove("copied");
    }, 1600);
  }

  document.querySelectorAll<HTMLButtonElement>(".copy-md .copy-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const href = btn.getAttribute("data-href");
      const label = btn.querySelector<HTMLElement>(".copy-label");
      if (!href || !label) return;
      const original = label.textContent ?? "";
      try {
        const res = await fetch(href);
        if (!res.ok) throw new Error(String(res.status));
        await copyText(await res.text());
        flash(btn, label, "Copied!", original);
      } catch {
        flash(btn, label, "Copy failed", original);
      }
    });
  });
</script>
