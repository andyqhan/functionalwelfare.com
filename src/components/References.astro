---
import Inline from "./paper/Inline.astro";
import { manifest } from "../lib/ir";
---
<section class="references" id="references">
  <h2 class="heading lvl-1">References</h2>
  <ol class="ref-list">
    {manifest.references.map((ref) => (
      <li id={`ref-${ref.key}`} value={ref.number}>
        <Inline nodes={ref.content} />
      </li>
    ))}
  </ol>
</section>
