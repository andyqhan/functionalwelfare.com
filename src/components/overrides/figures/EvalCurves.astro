---
// Interactive replacement for the steering eval-curve figures (Fig 4, and the
// appendix eval grids). Each figure is a grid of panels; every panel plots
// mean ± 95% bootstrap CI vs. steering strength for the v_Mold / v_Gold reward
// vectors (solid lines + shaded bands), with optional norm-matched u_Mold /
// u_Gold overlays (error bars) and right-axis "% incoherent" bars.
//
// The static figure shows the curves; here every curve point is hoverable —
// mousing over reveals the vector, the steering strength, and the exact mean
// with its CI. Everything is rendered server-side as SVG (faithful, works
// without JS); a small inline script adds nearest-point hit-testing + tooltip.
//
// Data: src/data/figures/eval-curves.json, from the upstream per-concept .dat
// tables by scripts/figure-data/build-eval-curves.mjs.
import Inline from "../../paper/Inline.astro";
import { preventWidow } from "../../../lib/typography";
import { renderMath } from "../../../lib/katex";
import type { FigureBlock, Footnote } from "../../../lib/ir";
import evalData from "../../../data/figures/eval-curves.json";

interface Props {
  node: FigureBlock;
  footnotes?: Footnote[];
}
const { node, footnotes = [] } = Astro.props;
const num = node.number;

function stemForItem(svg?: string): string | null {
  if (!svg) return null;
  const base = svg.split("/").pop()!.replace(/\.svg$/, "");
  return base.includes("__") ? base.split("__").pop()! : base;
}
type FigData = (typeof evalData.figures)[keyof typeof evalData.figures];
const stem = node.items.map((it) => stemForItem(it.svg)).find((s) => !!s && s in evalData.figures) ?? null;
const fig: FigData | null = stem ? (evalData.figures as Record<string, FigData>)[stem] : null;
const C = evalData.colors;

// =============================== geometry ================================
const ML = 32, MR = 8, MT = 8, MB = 18;
const PLOTW = 120, PLOTH = 104;
const W = ML + PLOTW + MR;
const H = MT + PLOTH + MB;
const XMIN = -4.5, XMAX = 4.5;

const MINUS = "−";
const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
function mathTextHtml(label: string | null | undefined): string {
  if (!label) return "";
  return label.split("$").map((seg, i) => (i % 2 ? renderMath(seg, false) : esc(seg))).join("");
}
const sx = (a: number) => ML + ((a - XMIN) / (XMAX - XMIN)) * PLOTW;

function yRange(kind: string): [number, number] {
  if (kind === "sentiment") return [-5.5, 5.5];
  if (kind === "ptrue") return [-0.03, 1.05];
  return [0, 1]; // percent
}
function yTicks(kind: string): number[] {
  if (kind === "sentiment") return [-5, -2.5, 0, 2.5, 5];
  return [0, 0.25, 0.5, 0.75, 1];
}
function yFmt(kind: string, v: number): string {
  if (kind === "percent") return `${Math.round(v * 100)}%`;
  if (kind === "ptrue") return v.toFixed(2);
  const s = Math.abs(v).toFixed(1);
  return v < 0 ? MINUS + s : s;
}
// tooltip value formatting (no axis tick rounding)
function vFmt(kind: string, v: number): string {
  if (kind === "percent") return `${(v * 100).toFixed(1)}%`;
  const s = Math.abs(v).toFixed(2);
  return v < 0 ? MINUS + s : s;
}

const ROLE_TEX: Record<string, string> = {
  "v:lava": "\\mathbf{v}_{\\mathrm{Mold}}",
  "v:goal": "\\mathbf{v}_{\\mathrm{Gold}}",
  "u:lava": "\\mathbf{u}_{\\mathrm{Mold}}",
  "u:goal": "\\mathbf{u}_{\\mathrm{Gold}}",
};

const XTICKS = [-4, -2, 0, 2, 4];

interface Panel { lines: any[]; nm: any[]; bars: any[] }

function buildPanel(panel: Panel, yaxis: string) {
  const [ylo, yhi] = yRange(yaxis);
  const sy = (v: number) => MT + ((yhi - v) / (yhi - ylo)) * PLOTH;
  const yClamp = (v: number) => Math.max(MT, Math.min(MT + PLOTH, sy(v)));
  let s = "";

  // axis frame (left + bottom)
  s += `<line class="ev-axis" x1="${ML}" y1="${MT}" x2="${ML}" y2="${MT + PLOTH}"/>`;
  s += `<line class="ev-axis" x1="${ML}" y1="${MT + PLOTH}" x2="${ML + PLOTW}" y2="${MT + PLOTH}"/>`;

  // y ticks + labels
  for (const t of yTicks(yaxis)) {
    if (t < ylo - 1e-9 || t > yhi + 1e-9) continue;
    const Y = sy(t);
    s += `<line class="ev-tick" x1="${ML - 3}" y1="${Y.toFixed(2)}" x2="${ML}" y2="${Y.toFixed(2)}"/>`;
    s += `<text class="ev-ticklbl" x="${ML - 5}" y="${(Y + 2.6).toFixed(2)}" text-anchor="end">${yFmt(yaxis, t)}</text>`;
  }
  // x ticks + labels
  for (const t of XTICKS) {
    const X = sx(t);
    s += `<line class="ev-tick" x1="${X.toFixed(2)}" y1="${MT + PLOTH}" x2="${X.toFixed(2)}" y2="${MT + PLOTH + 3}"/>`;
    s += `<text class="ev-ticklbl" x="${X.toFixed(2)}" y="${MT + PLOTH + 11}" text-anchor="middle">${t > 0 ? "+" + t : t}</text>`;
  }

  // zero rule
  if (ylo < 0 && 0 < yhi)
    s += `<line class="ev-zero" x1="${ML}" y1="${sy(0).toFixed(2)}" x2="${ML + PLOTW}" y2="${sy(0).toFixed(2)}"/>`;

  // incoherent bars (two per alpha, on a [0,1] scale)
  const sy01 = (v: number) => MT + (1 - v) * PLOTH;
  for (const b of panel.bars) {
    const col2 = C[b.role as "lava" | "goal"].line;
    const shift = b.role === "lava" ? -1.6 : 1.6;
    for (const [a, rate] of b.pts) {
      if (!(rate > 0)) continue;
      const X = sx(a) + shift;
      const y = sy01(rate);
      s += `<rect class="ev-bar" x="${(X - 1.1).toFixed(2)}" y="${y.toFixed(2)}" width="2.2" height="${(sy01(0) - y).toFixed(2)}" fill="${col2}"/>`;
    }
  }

  // CI bands
  for (const ln of panel.lines) {
    const fill = C[ln.role as "lava" | "goal"].fill;
    const up = ln.pts.map((p: number[]) => `${sx(p[0]).toFixed(2)},${yClamp(p[3]).toFixed(2)}`);
    const dn = ln.pts.map((p: number[]) => `${sx(p[0]).toFixed(2)},${yClamp(p[2]).toFixed(2)}`).reverse();
    s += `<polygon class="ev-band" points="${up.concat(dn).join(" ")}" fill="${fill}"/>`;
  }

  // nm (norm-matched u-vectors): dotted connecting line through the means, plus
  // open-square marks and CI error bars (mirrors the `lava nm`/`goal nm` style).
  for (const ser of panel.nm) {
    const c = C[ser.role as "lava" | "goal"].line;
    const pl = ser.pts.map((p: number[]) => `${sx(p[0]).toFixed(2)},${sy(p[1]).toFixed(2)}`).join(" ");
    s += `<polyline class="ev-nmline" points="${pl}" stroke="${c}"/>`;
    for (const p of ser.pts) {
      const X = sx(p[0]);
      s += `<line class="ev-nmbar" x1="${X.toFixed(2)}" y1="${yClamp(p[2]).toFixed(2)}" x2="${X.toFixed(2)}" y2="${yClamp(p[3]).toFixed(2)}" stroke="${c}"/>`;
      s += `<rect class="ev-nmmark" x="${(X - 1.4).toFixed(2)}" y="${(sy(p[1]) - 1.4).toFixed(2)}" width="2.8" height="2.8" stroke="${c}"/>`;
    }
  }

  // main lines + markers
  for (const ln of panel.lines) {
    const c = C[ln.role as "lava" | "goal"].line;
    const pl = ln.pts.map((p: number[]) => `${sx(p[0]).toFixed(2)},${sy(p[1]).toFixed(2)}`).join(" ");
    s += `<polyline class="ev-line" points="${pl}" stroke="${c}"/>`;
    for (const p of ln.pts)
      s += `<circle class="ev-dot" cx="${sx(p[0]).toFixed(2)}" cy="${sy(p[1]).toFixed(2)}" r="1.5" fill="${c}"/>`;
  }

  // hover hit-test points (v lines + u nm), with pixel coords baked
  const hp: any[] = [];
  for (const ln of panel.lines)
    for (const p of ln.pts) hp.push({ role: `v:${ln.role}`, a: p[0], m: p[1], lo: p[2], hi: p[3], px: +sx(p[0]).toFixed(2), py: +sy(p[1]).toFixed(2) });
  for (const ser of panel.nm)
    for (const p of ser.pts) hp.push({ role: `u:${ser.role}`, a: p[0], m: p[1], lo: p[2], hi: p[3], px: +sx(p[0]).toFixed(2), py: +sy(p[1]).toFixed(2) });

  return { svg: s, js: JSON.stringify({ W, yaxis, points: hp }) };
}

// Two layouts: Fig 4 has shared `cols`/`rows` headers; the appendix grids carry
// a per-panel `title` + spanning `groupHeaders` and `grid`.
const isFig4 = !!fig && "cols" in fig;
const ncols = fig ? (isFig4 ? (fig as any).cols.length : (fig as any).grid.cols) : 0;
const built = fig
  ? fig.panels.map((p: any, i: number) =>
      buildPanel(p as Panel, isFig4 ? (fig as any).cols[i % ncols].yaxis : p.yaxis))
  : [];

// legend entries (math labels rendered with KaTeX)
const legend = fig
  ? [
      { kind: "line", color: C.lava.line, html: renderMath(ROLE_TEX["v:lava"], false) },
      { kind: "line", color: C.goal.line, html: renderMath(ROLE_TEX["v:goal"], false) },
      { kind: "band", color: C.lava.fill, html: "95% bootstrap CI" },
      { kind: "nm", color: C.lava.line, html: renderMath(ROLE_TEX["u:lava"], false) },
      { kind: "nm", color: C.goal.line, html: renderMath(ROLE_TEX["u:goal"], false) },
      ...(fig.panels.some((p: any) => p.bars.length) ? [{ kind: "bar", color: C.lava.line, html: "% incoherent" }] : []),
    ]
  : [];
---

<figure id={node.id ?? node.label} class="fig ev-fig">
  {fig ? (
    <div class="ev-app" style={`--ev-cols:${ncols}`}>
      {(isFig4 ? (fig as any).title : (fig as any).suptitle) && (
        <div class="ev-suptitle">{isFig4 ? (fig as any).title : (fig as any).suptitle}</div>
      )}

      {isFig4 ? (
        <div class="ev-grid">
          {/* header row: corner + column titles */}
          <div class="ev-corner"></div>
          {(fig as any).cols.map((c: any) => <div class="ev-coltitle">{c.title}</div>)}
          {/* one grid row per data row */}
          {(fig as any).rows.map((r: any, ri: number) => (
            <>
              <div class="ev-rowlabel"><span>{r.label}</span></div>
              {(fig as any).cols.map((c: any, ci: number) => {
                const b = built[ri * ncols + ci];
                return (
                  <div class="ev-panel">
                    <div class="ev-ylabel">{c.ylabel}</div>
                    <div class="ev-svgbox">
                      <svg class="ev-svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${r.label} — ${c.title}`}>
                        <Fragment set:html={b.svg} />
                      </svg>
                      <div class="ev-hl" hidden></div>
                      <div class="ev-tip" hidden></div>
                    </div>
                    <script type="application/json" class="ev-data" set:html={b.js} />
                  </div>
                );
              })}
            </>
          ))}
        </div>
      ) : (
        <div class="ev-agrid">
          {(fig as any).groupHeaders?.length > 0 && (
            <div class="ev-headers">
              {(fig as any).groupHeaders.map((h: any) => (
                <div class="ev-gh" style={`grid-column:${h.fromCol} / ${h.toCol + 1}`}>{h.label}</div>
              ))}
            </div>
          )}
          <div class="ev-pgrid">
            {fig.panels.map((p: any, i: number) => (
              <div class="ev-acell">
                {p.title && <div class="ev-atitle" set:html={mathTextHtml(p.title)} />}
                <div class="ev-panel">
                  <div class="ev-ylabel" set:html={mathTextHtml(p.ylabel)} />
                  <div class="ev-svgbox">
                    <svg class="ev-svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={p.title ?? "eval panel"}>
                      <Fragment set:html={built[i].svg} />
                    </svg>
                    <div class="ev-hl" hidden></div>
                    <div class="ev-tip" hidden></div>
                  </div>
                  <script type="application/json" class="ev-data" set:html={built[i].js} />
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      <div class="ev-xlabel">Steering Strength</div>
      {legend.length > 0 && (
        <div class="ev-legend">
          {legend.map((l) => (
            <span class="ev-legitem">
              <svg class="ev-swatch" viewBox="0 0 22 10" aria-hidden="true">
                {l.kind === "line" && <><line x1="1" y1="5" x2="21" y2="5" stroke={l.color} stroke-width="1.6"/><circle cx="11" cy="5" r="2" fill={l.color}/></>}
                {l.kind === "band" && <rect x="1" y="2" width="20" height="6" fill={l.color} fill-opacity="0.6"/>}
                {l.kind === "nm" && <><line x1="1" y1="5" x2="21" y2="5" stroke={l.color} stroke-width="1" stroke-dasharray="2 1.5"/><rect x="9" y="3" width="4" height="4" fill="#fff" stroke={l.color}/></>}
                {l.kind === "bar" && <rect x="8" y="1" width="6" height="8" fill={l.color} fill-opacity="0.4" stroke={l.color} stroke-opacity="0.6" stroke-width="0.4"/>}
              </svg>
              <span class="ev-leglbl" set:html={l.html} />
            </span>
          ))}
        </div>
      )}
    </div>
  ) : (
    node.items.map((item) => <img src={item.svg ?? item.png} alt={`Figure ${node.number}`} loading="lazy" />)
  )}

  {(node.caption.length > 0 || num) && (
    <figcaption>
      {num && <span class="cap-label">Figure {num}.</span>}{" "}
      <Inline nodes={preventWidow(node.caption)} footnotes={footnotes} />
    </figcaption>
  )}
</figure>

<style>
  .ev-fig > .ev-app { grid-column: 2; grid-row: 1; min-width: 0; }
  .ev-app { font-family: var(--sans); color: var(--ink); }
  .ev-suptitle { text-align: center; font-weight: 700; font-size: 0.95rem; margin-bottom: 0.7rem; }

  .ev-grid {
    display: grid;
    grid-template-columns: 1.1rem repeat(var(--ev-cols), 1fr);
    gap: 0.3rem 0.5rem;
    align-items: center;
  }
  .ev-coltitle { text-align: center; font-weight: 700; font-size: 0.76rem; }
  .ev-corner { grid-column: 1; }

  /* appendix layout: spanning group headers + per-panel-titled grid */
  .ev-headers { display: grid; grid-template-columns: repeat(var(--ev-cols), 1fr); gap: 0 0.5rem; margin-bottom: 0.2rem; }
  .ev-gh { text-align: center; font-weight: 700; font-size: 0.78rem; }
  .ev-pgrid { display: grid; grid-template-columns: repeat(var(--ev-cols), 1fr); gap: 0.35rem 0.5rem; }
  .ev-acell { min-width: 0; }
  .ev-atitle { text-align: center; font-weight: 600; font-size: 0.64rem; line-height: 1.15; min-height: 1.4em; }
  .ev-atitle :global(.katex) { font-size: 1em; }
  .ev-rowlabel {
    grid-column: 1; writing-mode: vertical-rl; transform: rotate(180deg);
    text-align: center; font-weight: 700; font-size: 0.72rem; justify-self: center;
  }
  .ev-rowlabel span { white-space: nowrap; }

  .ev-panel { min-width: 0; display: grid; grid-template-columns: 0.85rem 1fr; align-items: center; }
  .ev-ylabel {
    grid-column: 1; writing-mode: vertical-rl; transform: rotate(180deg);
    text-align: center; font-size: 0.6rem; color: var(--muted); justify-self: center; white-space: nowrap;
  }
  .ev-svgbox { grid-column: 2; position: relative; min-width: 0; }
  .ev-svg { display: block; width: 100%; height: auto; overflow: visible; touch-action: none; }

  .ev-xlabel { text-align: center; font-size: 0.8rem; margin-top: 0.3rem; }

  .ev-legend { display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; justify-content: center; margin-top: 0.5rem; font-size: 0.78rem; }
  .ev-legitem { display: inline-flex; align-items: center; gap: 0.35rem; }
  .ev-swatch { width: 22px; height: 10px; flex: none; }
  .ev-leglbl :global(.katex) { font-size: 0.95em; }

  @media (max-width: 900px) {
    .ev-fig > .ev-app { grid-column: 1; }
  }
</style>

<style is:global>
  .ev-fig .ev-axis { stroke: #666; stroke-width: 0.5; }
  .ev-fig .ev-tick { stroke: #666; stroke-width: 0.5; }
  .ev-fig .ev-ticklbl { fill: var(--muted); font-size: 6px; font-variant-numeric: tabular-nums; }
  .ev-fig .ev-zero { stroke: #ddd; stroke-width: 0.6; }
  .ev-fig .ev-band { fill-opacity: 0.5; stroke: none; }
  .ev-fig .ev-line { fill: none; stroke-width: 1; }
  .ev-fig .ev-dot { stroke: #fff; stroke-width: 0.4; }
  .ev-fig .ev-nmline { fill: none; stroke-width: 0.6; stroke-dasharray: 1.4 1.2; opacity: 0.8; }
  .ev-fig .ev-nmbar { stroke-width: 0.7; opacity: 0.75; }
  .ev-fig .ev-nmmark { fill: #fff; stroke-width: 0.7; opacity: 0.85; }
  .ev-fig .ev-bar { fill-opacity: 0.4; }

  .ev-fig .ev-hl {
    position: absolute; width: 0; height: 0; pointer-events: none; border-radius: 50%;
    box-shadow: 0 0 0 1.5px var(--ink); transform: translate(-50%, -50%);
    transition: left 0.04s linear, top 0.04s linear; z-index: 3;
  }
  .ev-fig .ev-tip {
    position: absolute; z-index: 5; pointer-events: none; background: #fff;
    border: 1px solid var(--rule); border-radius: 7px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    padding: 0.35rem 0.5rem; font-family: var(--sans); font-size: 0.74rem; line-height: 1.3;
    color: var(--ink); white-space: nowrap;
  }
  .ev-fig .ev-tip-head { font-weight: 700; margin-bottom: 0.1rem; }
  .ev-fig .ev-tip-row { display: flex; justify-content: space-between; gap: 0.8rem; }
  .ev-fig .ev-tip-k { color: var(--muted); }
  .ev-fig .ev-tip-v { font-variant-numeric: tabular-nums; }
</style>

<script is:inline>
  (function () {
    var MINUS = "−";
    var PLAIN = { "v:lava": "v_Mold", "v:goal": "v_Gold", "u:lava": "u_Mold", "u:goal": "u_Gold" };
    var COLOR = { lava: "#D47971", goal: "#5B8DB8" };
    function vfmt(kind, v) {
      if (kind === "percent") return (v * 100).toFixed(1) + "%";
      var s = Math.abs(v).toFixed(2);
      return v < 0 ? MINUS + s : s;
    }

    document.querySelectorAll(".ev-fig .ev-panel").forEach(function (panel) {
      var dataEl = panel.querySelector(".ev-data");
      if (!dataEl) return;
      var D = JSON.parse(dataEl.textContent);
      if (!D.points.length) return;
      var svg = panel.querySelector(".ev-svg");
      var box = panel.querySelector(".ev-svgbox");
      var hl = panel.querySelector(".ev-hl");
      var tip = panel.querySelector(".ev-tip");

      function nearest(ev) {
        var pt = svg.createSVGPoint();
        pt.x = ev.clientX; pt.y = ev.clientY;
        var ctm = svg.getScreenCTM();
        if (!ctm) return null;
        var loc = pt.matrixTransform(ctm.inverse());
        var best = null, bd = Infinity;
        for (var i = 0; i < D.points.length; i++) {
          var p = D.points[i];
          var dx = p.px - loc.x, dy = p.py - loc.y;
          var d2 = dx * dx + dy * dy;
          if (d2 < bd) { bd = d2; best = p; }
        }
        return bd <= 36 ? best : null;
      }

      function show(p, ev) {
        var rect = box.getBoundingClientRect();
        var scale = rect.width / D.W;
        hl.hidden = false;
        hl.style.left = p.px * scale + "px";
        hl.style.top = p.py * scale + "px";
        hl.style.width = hl.style.height = Math.max(8, 6 * scale) + "px";

        var role = p.role.split(":")[1];
        tip.hidden = false;
        tip.innerHTML =
          '<div class="ev-tip-head" style="color:' + COLOR[role] + '">' + PLAIN[p.role] + "</div>" +
          '<div class="ev-tip-row"><span class="ev-tip-k">strength</span><span class="ev-tip-v">' + (p.a > 0 ? "+" + p.a : p.a) + "</span></div>" +
          '<div class="ev-tip-row"><span class="ev-tip-k">mean</span><span class="ev-tip-v">' + vfmt(D.yaxis, p.m) + "</span></div>" +
          '<div class="ev-tip-row"><span class="ev-tip-k">95% CI</span><span class="ev-tip-v">[' + vfmt(D.yaxis, p.lo) + ", " + vfmt(D.yaxis, p.hi) + "]</span></div>";

        var tw = tip.offsetWidth, th = tip.offsetHeight;
        var mx = ev.clientX - rect.left, my = ev.clientY - rect.top;
        var tx = mx + 12, ty = my + 12;
        if (tx + tw > rect.width) tx = mx - tw - 12;
        if (ty + th > rect.height) ty = my - th - 12;
        if (tx < 0) tx = 2;
        if (ty < 0) ty = 2;
        tip.style.left = tx + "px";
        tip.style.top = ty + "px";
      }

      function hide() { hl.hidden = true; tip.hidden = true; }

      svg.addEventListener("pointermove", function (ev) {
        var p = nearest(ev);
        if (p) show(p, ev);
        else hide();
      });
      svg.addEventListener("pointerleave", hide);
    });
  })();
</script>
