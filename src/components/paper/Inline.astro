---
import InlineNode from "./InlineNode.astro";
import { glueAtomicPunctuation } from "../../lib/typography";
import type { Inline, Footnote } from "../../lib/ir";

interface Props {
  nodes: Inline[];
  footnotes?: Footnote[];
}
const { nodes, footnotes = [] } = Astro.props;
// Keep punctuation from wrapping away from a preceding inline-math/emoji atom.
const glued = glueAtomicPunctuation(nodes);
---
{glued.map((node) => <InlineNode node={node} footnotes={footnotes} />)}
