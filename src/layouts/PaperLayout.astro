---
import "katex/dist/katex.min.css";
import "../styles/global.css";
import Toc from "../components/Toc.astro";

interface Props {
  title: string;
  currentSlug?: string;
}
const { title, currentSlug } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cardo:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <button id="toc-toggle" aria-label="Toggle contents">☰</button>
    <aside class="sidebar">
      <Toc currentSlug={currentSlug} />
    </aside>
    <main class="content">
      <slot />
    </main>
    <script is:inline>
      const t = document.getElementById("toc-toggle");
      t && t.addEventListener("click", () => document.body.classList.toggle("toc-open"));
    </script>
  </body>
</html>
