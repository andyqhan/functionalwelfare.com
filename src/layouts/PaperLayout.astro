---
import "katex/dist/katex.min.css";
import "../styles/global.css";
import Toc from "../components/Toc.astro";
import { manifest } from "../lib/ir";

interface Props {
  title: string;
  currentSlug?: string;
  /** Social-card description; defaults to the paper abstract. */
  description?: string;
  /** Social-card image (site-root path); defaults to the overview figure. */
  image?: string;
  /** Machine-readable Markdown version of this page, for rel=alternate + agents. */
  mdHref?: string;
}

// Flatten inline IR nodes to plain text (mirrors index.astro's `plain`).
const plainInline = (nodes: any[] = []): string =>
  nodes
    .map((n) =>
      n?.type === "text"
        ? n.value
        : n?.type === "break"
          ? " "
          : Array.isArray(n?.content)
            ? plainInline(n.content)
            : "",
    )
    .join("");

// Default social description = the paper abstract, collapsed and clamped.
const abstractText = (manifest.abstract ?? [])
  .map((b: any) => plainInline(b.content))
  .join(" ")
  .replace(/\s+/g, " ")
  .trim();

const { title, currentSlug, description, image = "/og-image.png", mdHref = "/index.md" } = Astro.props;
const ogTitle = title.replace(/\s+/g, " ").trim();
// The full abstract, collapsed to one line. Platforms truncate the *display*
// themselves (Twitter ~200 chars, Google ~155); arXiv likewise ships the whole
// abstract in its description tags rather than pre-clamping.
const desc = (description ?? abstractText).replace(/\s+/g, " ").trim();

// Absolute URLs for social cards (Astro.site is set in astro.config).
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/mousebot.png" type="image/png" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/markdown" href={mdHref} title="Markdown (for LLMs)" />

    <!-- Open Graph (Slack, Facebook, LinkedIn, iMessage, Discord) -->
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="functionalwelfare.com" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="600" />
    <meta
      property="og:image:alt"
      content="Overview: training, extracting, and evaluating the functional welfare axis."
    />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preload" href="/fonts/cardo-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cardo-bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cardo-italic.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Sans-serif (UI chrome, interactive figures): Alegreya Sans, a companion to
         Cardo. Monospace (tokens, prompts, code): Fira Code. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Alegreya+Sans:ital,wght@0,400;0,500;0,700;1,400&family=Fira+Code:wght@400;500&display=swap" />
    <script is:inline>
      // Restore a user-chosen sidebar width before first paint (no flash).
      try {
        const w = localStorage.getItem("fw-sidebar-w");
        if (w) document.documentElement.style.setProperty("--sidebar-w", w);
      } catch (e) {}
    </script>
  </head>
  <body>
    <header id="mobile-header">
      <button id="toc-toggle" aria-label="Toggle contents">☰</button>
      <a class="mh-title" href="/">How’s it going?</a>
    </header>
    <aside class="sidebar">
      <Toc currentSlug={currentSlug} />
    </aside>
    <script is:inline>
      // Each appendix is its own page, so following a sidebar link is a full
      // navigation that would otherwise reset the sidebar to the top. Persist
      // the sidebar scroll and restore it synchronously here — right after the
      // element is parsed, before first paint — so the position is maintained
      // with no visible jump.
      (function () {
        var el = document.querySelector(".sidebar");
        if (!el) return;
        try {
          var y = sessionStorage.getItem("fw-sidebar-scroll");
          if (y) el.scrollTop = parseFloat(y);
        } catch (e) {}
        var save = function () {
          try { sessionStorage.setItem("fw-sidebar-scroll", String(el.scrollTop)); } catch (e) {}
        };
        el.addEventListener("scroll", save, { passive: true });
        window.addEventListener("pagehide", save);
      })();
    </script>
    <div class="sidebar-resizer" role="separator" aria-orientation="vertical" aria-label="Resize sidebar" title="Drag to resize · double-click to reset"></div>
    <main class="content">
      <slot />
    </main>
    <div class="lightbox" id="lightbox" aria-hidden="true">
      <button class="lightbox-close" aria-label="Close">×</button>
      <figure class="lightbox-fig">
        <img alt="" />
        <figcaption class="lightbox-cap"></figcaption>
      </figure>
    </div>
    <script is:inline>
      const toggle = document.getElementById("toc-toggle");
      toggle && toggle.addEventListener("click", () => document.body.classList.toggle("toc-open"));

      // Auto-hiding mobile header (visible only in the narrow/drawer layout):
      // reveal on scroll-up or at the top, hide on scroll-down. CSS handles the
      // slide; this just toggles body.header-hidden based on scroll direction.
      (function () {
        if (!document.getElementById("mobile-header")) return;
        let lastY = window.scrollY, ticking = false;
        const update = () => {
          const y = window.scrollY;
          if (Math.abs(y - lastY) > 4) {
            if (y < 10 || y < lastY || document.body.classList.contains("toc-open"))
              document.body.classList.remove("header-hidden");
            else if (y > 64)
              document.body.classList.add("header-hidden");
            lastY = y;
          }
          ticking = false;
        };
        addEventListener("scroll", () => {
          if (!ticking) { ticking = true; requestAnimationFrame(update); }
        }, { passive: true });
      })();

      const rez = document.querySelector(".sidebar-resizer");
      if (rez) {
        const root = document.documentElement;
        const clamp = (x) => Math.max(190, Math.min(560, x));
        let dragging = false;
        rez.addEventListener("pointerdown", (e) => {
          dragging = true;
          document.body.classList.add("resizing");
          rez.setPointerCapture(e.pointerId);
          e.preventDefault();
        });
        rez.addEventListener("pointermove", (e) => {
          if (dragging) root.style.setProperty("--sidebar-w", clamp(e.clientX) + "px");
        });
        const end = () => {
          if (!dragging) return;
          dragging = false;
          document.body.classList.remove("resizing");
          try {
            localStorage.setItem("fw-sidebar-w", getComputedStyle(root).getPropertyValue("--sidebar-w").trim());
          } catch (e) {}
          requestAnimationFrame(() => { placeCaptions(); padTrailingCaption(); }); // figure heights changed with the column width
        };
        rez.addEventListener("pointerup", end);
        rez.addEventListener("pointercancel", end);
        rez.addEventListener("dblclick", () => {
          root.style.removeProperty("--sidebar-w");
          try { localStorage.removeItem("fw-sidebar-w"); } catch (e) {}
        });
      }

      // In the enhanced (wide) layout, figure/table captions hang in the left
      // gutter and a tall one overflows *downward*, where it can run into a
      // following section heading's hanging marker (e.g. Fig 3's caption vs the
      // §3.3 marker). For each caption that collides, slide it up just enough to
      // clear the nearest marker — so it ends near the figure's bottom instead
      // of starting at the top and spilling into the heading. Captions are
      // absolutely positioned, so nudging one reflows nothing else.
      const enhancedMQ = window.matchMedia("(min-width: 1560px)");
      function placeCaptions() {
        const caps = document.querySelectorAll(".fig > figcaption, .tbl > figcaption");
        caps.forEach((c) => { c.style.top = ""; }); // reset to the CSS default (top: 0)
        if (!enhancedMQ.matches) return;             // markers only hang at this width
        const markers = [...document.querySelectorAll(".heading > .sec-num")].map((m) => m.getBoundingClientRect());
        const GAP = 8; // px of breathing room between caption bottom and marker
        caps.forEach((c) => {
          const cr = c.getBoundingClientRect();
          let clashTop = Infinity;
          for (const mr of markers) {
            const overlapsX = mr.left < cr.right && mr.right > cr.left;
            const runsInto = mr.top > cr.top && mr.top < cr.bottom; // caption spills onto it
            if (overlapsX && runsInto) clashTop = Math.min(clashTop, mr.top);
          }
          if (clashTop !== Infinity) {
            const shift = cr.bottom + GAP - clashTop;
            if (shift > 0) c.style.top = -Math.round(shift) + "px";
          }
        });
      }

      // At the end of an appendix the last figure/table has nothing below it but
      // the prev/next footer. Its caption is absolutely placed (out of the box's
      // height), so a tall one overflows past the image and would land on top of
      // that footer — which is positioned by the image height, not the caption.
      // Reserve bottom space on the float equal to the caption's overhang so the
      // footer clears it. Only the enhanced layout hangs the caption out of flow
      // (narrower widths stack it below, in document flow), and only appendix
      // pages carry the footer — so this is a no-op everywhere else.
      function padTrailingCaption() {
        const last = [...document.querySelectorAll(".unit > .fig, .unit > .tbl")].pop();
        if (!last) return;
        last.style.marginBottom = ""; // reset before measuring (e.g. on shrink / image load)
        if (!document.querySelector(".appendix-nav") || !enhancedMQ.matches) return;
        const cap = last.querySelector(":scope > figcaption");
        if (!cap) return;
        const GAP = 24; // breathing room between the caption and the footer rule
        const overhang = cap.getBoundingClientRect().bottom - last.getBoundingClientRect().bottom;
        if (overhang > 0) last.style.marginBottom = Math.ceil(overhang + GAP) + "px";
      }
      const schedulePlace = () => requestAnimationFrame(() => { placeCaptions(); padTrailingCaption(); });
      schedulePlace();
      window.addEventListener("load", schedulePlace);
      window.addEventListener("resize", schedulePlace);
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(schedulePlace);
      // Figure/table images are lazy-loaded, so a below-the-fold figure measures
      // as zero-height until it scrolls into view — which would make the next
      // section marker look like it sits at the figure's top and push the caption
      // far too high. Re-place captions whenever a figure's content actually
      // resizes (image decode, lazy load, reflow), so the nudge is measured
      // against the real figure height and stays minimal.
      if ("ResizeObserver" in window) {
        const ro = new ResizeObserver(schedulePlace);
        document.querySelectorAll(".fig > .fig-items, .tbl > .tbl-body").forEach((el) => ro.observe(el));
      }

      // Figure/table lightbox: click a static image to view it full screen.
      const lb = document.getElementById("lightbox");
      if (lb) {
        const lbImg = lb.querySelector("img");
        const lbCap = lb.querySelector(".lightbox-cap");
        const lbFig = lb.querySelector(".lightbox-fig");
        // Keep the caption at its preferred width (--lb-cap-w); if a long caption
        // would overflow the height left under the image, widen it toward the
        // available space, and only enable scrolling if even full width won't fit.
        const fitCaption = () => {
          if (!lbCap.textContent.trim()) return;
          lbCap.style.maxHeight = "none"; lbCap.style.overflowY = "visible"; lbCap.style.maxWidth = "";
          const cs = getComputedStyle(lbFig);
          const chromeV = parseFloat(cs.paddingTop) + parseFloat(cs.paddingBottom) + (parseFloat(cs.rowGap) || 0);
          const imgH = lbImg.getBoundingClientRect().height || 0.75 * window.innerHeight;
          const budget = Math.max(48, 0.94 * window.innerHeight - chromeV - imgH);
          if (lbCap.scrollHeight <= budget + 1) return; // fits at the defined width
          const maxW = 0.96 * window.innerWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
          const preferredW = lbCap.getBoundingClientRect().width;
          const fitsAt = (w) => { lbCap.style.maxWidth = w + "px"; return lbCap.scrollHeight <= budget + 1; };
          if (maxW <= preferredW || !fitsAt(maxW)) { // last resort: full width + scroll
            lbCap.style.maxWidth = maxW + "px"; lbCap.style.maxHeight = budget + "px"; lbCap.style.overflowY = "auto";
            return;
          }
          let lo = preferredW, hi = maxW; // narrowest width that avoids scrolling
          for (let i = 0; i < 7; i++) { const mid = (lo + hi) / 2; if (fitsAt(mid)) hi = mid; else lo = mid; }
          lbCap.style.maxWidth = Math.ceil(hi) + "px";
        };
        const open = (src, alt, captionHTML) => {
          lbImg.onload = fitCaption;
          lbImg.src = src; lbImg.alt = alt || "";
          lbCap.innerHTML = captionHTML || "";
          lb.classList.add("open"); lb.setAttribute("aria-hidden", "false");
          fitCaption();
        };
        const close = () => {
          lb.classList.remove("open"); lb.setAttribute("aria-hidden", "true");
          lbImg.onload = null; lbImg.removeAttribute("src"); lbCap.innerHTML = "";
          lbCap.style.maxWidth = lbCap.style.maxHeight = lbCap.style.overflowY = "";
        };
        window.addEventListener("resize", () => { if (lb.classList.contains("open")) fitCaption(); });
        document.addEventListener("click", (e) => {
          const img = e.target.closest(".fig-items img, .tbl-img");
          if (img) {
            const cap = img.closest("figure")?.querySelector(":scope > figcaption");
            open(img.currentSrc || img.src, img.alt, cap ? cap.innerHTML : "");
          }
        });
        // Click the backdrop or image to dismiss; clicks inside the caption read/select without closing.
        lb.addEventListener("click", (e) => { if (!e.target.closest(".lightbox-cap")) close(); });
        document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });
      }
    </script>
  </body>
</html>
