---
import "katex/dist/katex.min.css";
import "../styles/global.css";
import Toc from "../components/Toc.astro";

interface Props {
  title: string;
  currentSlug?: string;
}
const { title, currentSlug } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/mousebot.png" type="image/png" />
    <title>{title}</title>
    <link rel="preload" href="/fonts/cardo-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cardo-bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cardo-italic.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Sans-serif (UI chrome, interactive figures): Alegreya Sans, a companion to
         Cardo. Monospace (tokens, prompts, code): Fira Code. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Alegreya+Sans:ital,wght@0,400;0,500;0,700;1,400&family=Fira+Code:wght@400;500&display=swap" />
    <script is:inline>
      // Restore a user-chosen sidebar width before first paint (no flash).
      try {
        const w = localStorage.getItem("fw-sidebar-w");
        if (w) document.documentElement.style.setProperty("--sidebar-w", w);
      } catch (e) {}
    </script>
  </head>
  <body>
    <button id="toc-toggle" aria-label="Toggle contents">☰</button>
    <aside class="sidebar">
      <Toc currentSlug={currentSlug} />
    </aside>
    <div class="sidebar-resizer" role="separator" aria-orientation="vertical" aria-label="Resize sidebar" title="Drag to resize · double-click to reset"></div>
    <main class="content">
      <slot />
    </main>
    <div class="lightbox" id="lightbox" aria-hidden="true">
      <button class="lightbox-close" aria-label="Close">×</button>
      <figure class="lightbox-fig">
        <img alt="" />
        <figcaption class="lightbox-cap"></figcaption>
      </figure>
    </div>
    <script is:inline>
      const toggle = document.getElementById("toc-toggle");
      toggle && toggle.addEventListener("click", () => document.body.classList.toggle("toc-open"));

      const rez = document.querySelector(".sidebar-resizer");
      if (rez) {
        const root = document.documentElement;
        const clamp = (x) => Math.max(190, Math.min(560, x));
        let dragging = false;
        rez.addEventListener("pointerdown", (e) => {
          dragging = true;
          document.body.classList.add("resizing");
          rez.setPointerCapture(e.pointerId);
          e.preventDefault();
        });
        rez.addEventListener("pointermove", (e) => {
          if (dragging) root.style.setProperty("--sidebar-w", clamp(e.clientX) + "px");
        });
        const end = () => {
          if (!dragging) return;
          dragging = false;
          document.body.classList.remove("resizing");
          try {
            localStorage.setItem("fw-sidebar-w", getComputedStyle(root).getPropertyValue("--sidebar-w").trim());
          } catch (e) {}
        };
        rez.addEventListener("pointerup", end);
        rez.addEventListener("pointercancel", end);
        rez.addEventListener("dblclick", () => {
          root.style.removeProperty("--sidebar-w");
          try { localStorage.removeItem("fw-sidebar-w"); } catch (e) {}
        });
      }

      // Figure/table lightbox: click a static image to view it full screen.
      const lb = document.getElementById("lightbox");
      if (lb) {
        const lbImg = lb.querySelector("img");
        const lbCap = lb.querySelector(".lightbox-cap");
        const lbFig = lb.querySelector(".lightbox-fig");
        // Keep the caption at its preferred width (--lb-cap-w); if a long caption
        // would overflow the height left under the image, widen it toward the
        // available space, and only enable scrolling if even full width won't fit.
        const fitCaption = () => {
          if (!lbCap.textContent.trim()) return;
          lbCap.style.maxHeight = "none"; lbCap.style.overflowY = "visible"; lbCap.style.maxWidth = "";
          const cs = getComputedStyle(lbFig);
          const chromeV = parseFloat(cs.paddingTop) + parseFloat(cs.paddingBottom) + (parseFloat(cs.rowGap) || 0);
          const imgH = lbImg.getBoundingClientRect().height || 0.75 * window.innerHeight;
          const budget = Math.max(48, 0.94 * window.innerHeight - chromeV - imgH);
          if (lbCap.scrollHeight <= budget + 1) return; // fits at the defined width
          const maxW = 0.96 * window.innerWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
          const preferredW = lbCap.getBoundingClientRect().width;
          const fitsAt = (w) => { lbCap.style.maxWidth = w + "px"; return lbCap.scrollHeight <= budget + 1; };
          if (maxW <= preferredW || !fitsAt(maxW)) { // last resort: full width + scroll
            lbCap.style.maxWidth = maxW + "px"; lbCap.style.maxHeight = budget + "px"; lbCap.style.overflowY = "auto";
            return;
          }
          let lo = preferredW, hi = maxW; // narrowest width that avoids scrolling
          for (let i = 0; i < 7; i++) { const mid = (lo + hi) / 2; if (fitsAt(mid)) hi = mid; else lo = mid; }
          lbCap.style.maxWidth = Math.ceil(hi) + "px";
        };
        const open = (src, alt, captionHTML) => {
          lbImg.onload = fitCaption;
          lbImg.src = src; lbImg.alt = alt || "";
          lbCap.innerHTML = captionHTML || "";
          lb.classList.add("open"); lb.setAttribute("aria-hidden", "false");
          fitCaption();
        };
        const close = () => {
          lb.classList.remove("open"); lb.setAttribute("aria-hidden", "true");
          lbImg.onload = null; lbImg.removeAttribute("src"); lbCap.innerHTML = "";
          lbCap.style.maxWidth = lbCap.style.maxHeight = lbCap.style.overflowY = "";
        };
        window.addEventListener("resize", () => { if (lb.classList.contains("open")) fitCaption(); });
        document.addEventListener("click", (e) => {
          const img = e.target.closest(".fig-items img, .tbl-img");
          if (img) {
            const cap = img.closest("figure")?.querySelector(":scope > figcaption");
            open(img.currentSrc || img.src, img.alt, cap ? cap.innerHTML : "");
          }
        });
        // Click the backdrop or image to dismiss; clicks inside the caption read/select without closing.
        lb.addEventListener("click", (e) => { if (!e.target.closest(".lightbox-cap")) close(); });
        document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });
      }
    </script>
  </body>
</html>
