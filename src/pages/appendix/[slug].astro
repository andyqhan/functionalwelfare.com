---
import PaperLayout from "../../layouts/PaperLayout.astro";
import Blocks from "../../components/paper/Blocks.astro";
import Inline from "../../components/paper/Inline.astro";
import AppendixOverview from "../../components/paper/AppendixOverview.astro";
import { appendixSummaries, getUnit, appendixParam, unitPath } from "../../lib/ir";

export function getStaticPaths() {
  return appendixSummaries().map((s) => ({
    params: { slug: appendixParam(s.slug) },
    props: { unitSlug: s.slug },
  }));
}

const { unitSlug } = Astro.props;
const unit = getUnit(unitSlug)!;
const summaries = appendixSummaries();
const idx = summaries.findIndex((s) => s.slug === unitSlug);
const prev = idx > 0 ? summaries[idx - 1] : null;
const next = idx < summaries.length - 1 ? summaries[idx + 1] : null;

const summary = summaries[idx];
const plainTitle = (summary.number ? `Appendix ${summary.number} · ` : "") + summary.title.map((n) => (n.type === "text" ? n.value : "")).join("");
---
<PaperLayout title={plainTitle} currentSlug={unitSlug}>
  <article class="paper appendix">
    <section class="unit" id={unit.slug} data-slug={unit.slug}>
      {unitSlug === "appendix-overview"
        ? <AppendixOverview blocks={unit.blocks} />
        : <Blocks blocks={unit.blocks} footnotes={unit.footnotes} />}
    </section>
    <nav class="appendix-nav">
      <span>{prev ? <a href={unitPath(prev.slug)}>← <Inline nodes={prev.title} /></a> : <a href="/">← Back to paper</a>}</span>
      <span>{next && <a href={unitPath(next.slug)}><Inline nodes={next.title} /> →</a>}</span>
    </nav>
  </article>
</PaperLayout>
